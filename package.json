{
  "name": "hephaestus-postman-framework",
  "version": "4.0.1",
  "description": "Modular API testing automation framework for Postman",
  "license": "MIT",
  "author": "Bogdanov Igor <bogdanov.ig.alex@gmail.com>",
  "homepage": "https://github.com/bogdanov-igor/hephaestus-postman-framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogdanov-igor/hephaestus-postman-framework.git"
  },
  "bin": {
    "hephaestus": "bin/hephaestus.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "engine/",
    "setup/",
    "templates/",
    "collection/",
    "docs/override.schema.json",
    "!scripts/test.js",
    "!scripts/test-engine.js",
    "!scripts/build.js",
    "!scripts/check-locales.js",
    "!scripts/fixtures/",
    "!engine/src/"
  ],
  "scripts": {
    "lint": "eslint engine/ setup/ templates/",
    "lint:fix": "eslint engine/ setup/ templates/ --fix",
    "syntax": "node --check engine/pre-request.js && node --check engine/post-request.js && node --check setup/engine-update.js && node --check setup/snapshot-clear.js && node --check setup/snapshot-view.js && node --check templates/method.pre-request.js && node --check templates/method.post-request.js",
    "validate:defaults": "node -e \"JSON.parse(require('fs').readFileSync('setup/defaults.json','utf8')); console.log('✅ defaults.json valid')\"",
    "check:locales": "node scripts/check-locales.js",
    "build": "node scripts/build.js",
    "build:emit": "node scripts/build.js --emit",
    "test": "node scripts/test.js && node scripts/test-engine.js",
    "test:engine": "node scripts/test-engine.js",
    "migrate": "node scripts/migrate.js",
    "docs": "node scripts/docs.js",
    "sync-examples": "node scripts/sync-examples.js",
    "openapi": "node scripts/openapi-import.js",
    "summary": "node scripts/summary.js",
    "compare": "node scripts/compare.js",
    "watch": "node scripts/watch.js",
    "init": "node scripts/init.js",
    "ci-to-junit": "node scripts/ci-to-junit.js",
    "report": "node scripts/generate-report.js"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "eslint": "^9.0.0",
    "newman": "^6.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
