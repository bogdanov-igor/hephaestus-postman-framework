# Normalize line endings to LF in the working tree on every platform.
#
# Rationale: the build CHECK (scripts/build.js), the engine golden harness
# (scripts/test-engine.js) and the doctor integrity check (scripts/doctor.js)
# all compare freshly generated LF bytes against committed files byte-for-byte
# / by SHA-256. Without this, a Windows checkout (git core.autocrlf=true) would
# materialize CRLF and break all three — plus give every Windows `doctor` user a
# false engine-integrity failure. Committed files are already LF, so this changes
# nothing except what lands in a Windows working tree.
* text=auto eol=lf

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
